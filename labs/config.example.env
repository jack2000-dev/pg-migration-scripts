# Copy to local/config.env. Do not put passwords here; use a mode-0600 .pgpass.
# These are database names, and each must exist on both source and target.
LAB_DATABASES=lab_db1,lab_db2
LAB_APP_USER=lab_app
SOURCE_VALIDATION_USER=doadmin
TARGET_VALIDATION_USER=migration_admin
SOURCE_REPLICATION_USER=lab_forward_repl
TARGET_REPLICATION_USER=lab_reverse_repl
LAB_ACCOUNT_COUNT=10000
LAB_CLIENTS=4
LAB_TPS=20

SOURCE_HOST=source.example.com
SOURCE_PORT=25060
SOURCE_SSLMODE=verify-full
SOURCE_SSLROOTCERT=/absolute/path/to/digitalocean-ca.crt

TARGET_HOST=target.example.com
TARGET_PORT=5432
TARGET_SSLMODE=verify-full
TARGET_SSLROOTCERT=/absolute/path/to/openstack-postgresql-ca.crt
